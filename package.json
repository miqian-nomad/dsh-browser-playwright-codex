{
  "name": "dsh-browser-playwright-codex",
  "version": "0.5.1",
  "description": "Browser automation for DeepSeek Harness: fill in forms, scrape lists and work across tabs in real pages, using the logins you already have. Runs in a visible window that stays quiet when minimised, and stops for sign-ins, CAPTCHAs and native dialogs instead of confirming for you.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    },
    "./playwright": {
      "types": "./lib/playwright.d.ts",
      "default": "./lib/playwright.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./runtime-state": {
      "default": "./lib/runtime-state.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "locale"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node node_modules/tsx/dist/cli.mjs --test \"tests/*.test.ts\"",
    "test:scenarios": "node node_modules/tsx/dist/cli.mjs --test tests/scenarios.test.ts tests/tool-scenarios.test.ts",
    "test:live": "node node_modules/tsx/dist/cli.mjs --test tests/live-smoke.test.ts",
    "verify": "npm run build && node scripts/dsh-browser-verify.mjs",
    "verify:live": "npm run build && node scripts/dsh-browser-verify.mjs --live",
    "doctor": "node scripts/doctor.mjs",
    "cost": "node node_modules/tsx/dist/cli.mjs scripts/measure-prompt-cost.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*",
    "playwright-core": "~1.62.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "playwright",
    "web-automation",
    "agent",
    "automation",
    "browser-automation",
    "web-scraping",
    "form-filling",
    "deepseek",
    "ai-agent",
    "rpa"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.31.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miqian-nomad/dsh-browser-playwright-codex.git"
  },
  "homepage": "https://github.com/miqian-nomad/dsh-browser-playwright-codex#readme"
}
